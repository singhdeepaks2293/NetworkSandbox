# --- build stage -----------------------------------------------------------
FROM rust:1.75-alpine AS build

RUN apk add --no-cache musl-dev gcc
WORKDIR /src

COPY Cargo.toml Cargo.lock ./
COPY src ./src

# Static musl binary, size-optimised
RUN cargo build --release --locked

# Directories the daemon expects in the runtime image
RUN mkdir -p /out/etc/switch /out/run/switch

# --- runtime stage ---------------------------------------------------------
FROM alpine:3.19

# Install ttyd (web terminal) and dependencies
RUN apk add --no-cache ttyd ncurses

# Copy compiled switch binary from build stage to /switch
COPY --from=build /src/target/release/switch /switch
COPY --from=build /out/etc/switch /etc/switch
COPY --from=build /out/run/switch /run/switch

# Copy the startup script and make it executable
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Expose HTTP port for the web browser / platform
EXPOSE 8080

ENTRYPOINT ["/entrypoint.sh"]